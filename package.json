{
  "name": "keyoku",
  "version": "2.2.0",
  "description": "The harness with muscle memory — watches what you do in Claude Code, Cursor, or Codex, learns your patterns, and turns them into reusable MCP-native workflows.",
  "type": "module",
  "bin": {
    "keyoku": "dist/index.js"
  },
  "main": "dist/index.js",
  "exports": { ".": "./dist/index.js" },
  "files": [
    "dist/*.js",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsx src/index.ts serve",
    "test": "npm run build && vitest run",
    "test:watch": "vitest",
    "eval": "tsx evals/muscle-memory.eval.ts",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "keyoku",
    "mcp",
    "model-context-protocol",
    "claude-code",
    "cursor",
    "agents",
    "workflow",
    "activity-tracing",
    "automation"
  ],
  "author": "Keyoku <support@keyoku.ai>",
  "license": "MIT",
  "homepage": "https://keyoku.ai",
  "repository": {
    "type": "git",
    "url": "https://github.com/Keyoku-ai/keyoku"
  },
  "bugs": {
    "url": "https://github.com/Keyoku-ai/keyoku/issues"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.104.1",
    "@modelcontextprotocol/sdk": "^1.12.0",
    "jmespath": "^0.16.0",
    "yaml": "^2.9.0",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@types/jmespath": "^0.15.2",
    "@types/node": "^20.10.0",
    "tsup": "^8.0.1",
    "tsx": "^4.19.0",
    "typescript": "^5.3.0",
    "vitest": "^1.0.0"
  }
}
